{
  "name": "torah-pod-accounts-production",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "ENVIRONMENT": "production", "LISTENER_ACCOUNTS": "false", "PUBLISHER_ACCESS": "false" },
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "42001", "simple": { "limit": 120, "period": 60 } },
    { "name": "USER_LIMITER", "namespace_id": "42002", "simple": { "limit": 120, "period": 60 } },
    { "name": "PUBLISHER_LIMITER", "namespace_id": "42003", "simple": { "limit": 5, "period": 60 } },
    { "name": "INTERNAL_LIMITER", "namespace_id": "42004", "simple": { "limit": 60, "period": 60 } }
  ]
}
